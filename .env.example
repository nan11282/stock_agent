DEEPSEEK_API_KEY_stock_agent=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DB_PATH=/app/data/investment_live.db
# Windows + Docker bind mount 下 WAL/SHM 文件锁容易异常；默认 DELETE 更稳。
SQLITE_JOURNAL_MODE=DELETE

# 单次 LLM 请求超时。DeepSeek 长推理偶尔会超过数分钟，过短会导致已生成中的回答被截断。
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=0
# 定时日报 LLM 深度分析失败后的最大尝试次数；连续失败后降级为规则扫描摘要
LLM_ANALYSIS_MAX_ATTEMPTS=3
LLM_ANALYSIS_RETRY_DELAY_SECONDS=2

MAIL_USER=your_qq@qq.com
MAIL_PASS=xxxxxxxxxxxxxxxx
MAIL_TO=recipient@example.com

# Telegram Bot（通过 @BotFather 创建获取）
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_TIMEOUT_SECONDS=1800
TELEGRAM_AGENT_MAX_STEPS=8
TELEGRAM_CONNECTION_POOL_SIZE=32
TELEGRAM_GET_UPDATES_POOL_SIZE=8
TELEGRAM_POOL_TIMEOUT_SECONDS=30
TELEGRAM_CONNECT_TIMEOUT_SECONDS=30
TELEGRAM_READ_TIMEOUT_SECONDS=60
# 记忆检索：普通实时查询推荐跳过历史记忆；设为 always 可强制每轮检索
MEMORY_RETRIEVE_POLICY=conservative_skip

# 对话摘要写入默认后台执行；调试时可设为 false 恢复同步
ASYNC_MEMORY_WRITE=true

# 分析型问答中最多允许几轮读工具调用；达到上限后基于已有数据总结
AGENT_READ_TOOL_ROUNDS=1

# 记忆检索 rerank（默认关闭模型 rerank，使用轻量 lexical rerank；需要更强语义召回时设为 1）
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_POOL_SIZE=12
